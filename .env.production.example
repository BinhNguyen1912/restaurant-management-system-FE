# Copy sang .env.production trên VPS rồi điền domain thật. KHÔNG commit .env.production.
# Đây là BUILD-TIME args: đổi giá trị = phải build lại image (docker compose build fe).

# API công khai (BE) — dùng bởi cả trình duyệt và route handler server-side của Next
NEXT_PUBLIC_API_ENDPOINT=https://api.abc.com
# URL của chính FE
NEXT_PUBLIC_URL=https://app.abc.com

NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_AUTHORIZED_REDIRECT_URI=https://app.abc.com/auth/login/google
