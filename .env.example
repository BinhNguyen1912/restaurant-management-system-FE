# Copy sang .env roi dien gia tri thuc. Cac key deu la NEXT_PUBLIC_* (public, nhung van khong nen commit .env)
NEXT_PUBLIC_API_ENDPOINT=http://localhost:4000
NEXT_PUBLIC_URL=http://localhost:3000

# Google OAuth: redirect URI phai trung khop voi Google Cloud Console
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_AUTHORIZED_REDIRECT_URI=http://localhost:3000/auth/login/google
